# Add phase-specific server secrets here when their integrations are implemented.
# Never commit populated .env files.

# Development database must support transactions (Atlas or a replica set).
MONGODB_URI=
# Set to the exact public origin in production.
APP_ORIGIN=

# Self-hosted production only. The reverse proxy must overwrite this header.
# Leave empty on Vercel and in local development.
TRUSTED_CLIENT_IP_HEADER=

# Organizer invitation emails. Copy these names into .env.local and add real values there.
# RESEND_FROM_EMAIL must use a sender/domain verified in your Resend account.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# 32 random bytes, base64 encoded. Generated locally for invitation code verification/encryption.
INVITATION_CODE_SECRET=
# Starting platform-wide daily cap for organizer invitation sends.
INVITATION_EMAIL_DAILY_LIMIT=100
